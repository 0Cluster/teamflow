NODE_ENV=development
PORT=5000
# Local MongoDB (works out of the box):
MONGODB_URI=mongodb://localhost:27017/teamflow
# MongoDB Atlas instead (paste your cluster string as-is):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/teamflow?retryWrites=true&w=majority
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# SameSite for the refresh cookie: keep "lax" when web+API share a
# domain; use "none" for split-domain hosting (requires NODE_ENV=production).
# COOKIE_SAMESITE=lax
# Optional. When unset, rate limits use memory and caches pass through.
# Upstash REST (recommended for hosting; both values required):
# UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
# Local/native Redis instead (also required for multi-instance socket fan-out):
# REDIS_URL=redis://localhost:6379
# Native Upstash endpoint (ioredis negotiates TLS on rediss:// automatically):
# REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379
