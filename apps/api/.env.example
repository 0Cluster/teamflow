NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/teamflow
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Optional. When unset, rate limits use memory and caches pass through.
# Local Redis:
# REDIS_URL=redis://localhost:6379
# Upstash (paste the endpoint URL from your Upstash console as-is;
# it starts with rediss:// and TLS is negotiated automatically):
# REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379
